# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …sauf le gabarit, qui ne contient que des valeurs d'exemple et sert au README.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Skills d'agent récupérées depuis des dépôts tiers : outillage de
# l'environnement de développement, pas du code applicatif.
# `.claude/launch.json` reste versionné, lui : il décrit comment lancer l'app.
/.agents/
/.claude/skills/
/skills-lock.json
