# Copier en .env.local — ou laisser `vercel env pull .env.local` le remplir.

# Postgres Neon.
#
# Deux URLs sont nécessaires : le pooler ne supporte pas les verrous de session
# dont Prisma a besoin pour migrer. L'application utilise la connexion poolée
# (voir lib/db.ts), les migrations la connexion directe (voir prisma.config.ts).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# Secret de signature des sessions Better Auth.
# En générer un : openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Domaine de l'application : localhost en développement, le domaine public en production.
BETTER_AUTH_URL="http://localhost:3000"
